<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet
            id="008-create-upload-sessions"
            author="edward">

        <createTable tableName="upload_sessions">

            <column name="id" type="UUID">
                <constraints
                        primaryKey="true"
                        primaryKeyName="pk_upload_sessions"
                        nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="folder_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column
                    name="expected_files"
                    type="BIGINT"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column
                    name="expected_bytes"
                    type="BIGINT"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_upload_sessions_user"
                baseTableName="upload_sessions"
                baseColumnNames="user_id"
                referencedTableName="app_users"
                referencedColumnNames="id"
                onDelete="RESTRICT"/>

        <createIndex
                tableName="upload_sessions"
                indexName="ix_upload_sessions_user_created">

            <column name="user_id"/>
            <column name="created_at" descending="true"/>

        </createIndex>

        <addCheckConstraint
                tableName="upload_sessions"
                constraintName="chk_upload_sessions_expected_files"
                constraintBody="expected_files &gt;= 0"/>

        <addCheckConstraint
                tableName="upload_sessions"
                constraintName="chk_upload_sessions_expected_bytes"
                constraintBody="expected_bytes &gt;= 0"/>

        <addCheckConstraint
                tableName="upload_sessions"
                constraintName="chk_upload_sessions_status"
                constraintBody="status IN ('CREATED', 'UPLOADING', 'COMPLETED', 'EXPIRED', 'FAILED')"/>

        <rollback>
            <dropTable
                    tableName="upload_sessions"
                    cascadeConstraints="true"/>
        </rollback>

    </changeSet>

</databaseChangeLog>